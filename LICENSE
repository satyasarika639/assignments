#include <stdint.h>
#include <stdbool.h>

// Assume you already have I2C_Write(uint8_t devAddr, uint8_t reg, uint8_t data)

#define KTD2026_I2C_ADDR   0x30  // Default device address

// Register addresses
#define REG_EN_RST   0x00
#define REG_LED_EN   0x04
#define REG_LED1_CUR 0x06
#define REG_LED2_CUR 0x07
#define REG_LED3_CUR 0x08

// Example LED current (10mA ≈ 0x4F)
#define LED_CUR_10mA 0x4F

// Initialize device
void KTD2026_Init(void) {
    // Reset device
    I2C_Write(KTD2026_I2C_ADDR, REG_EN_RST, 0x07);  // Complete reset
    // Enable device always ON
    I2C_Write(KTD2026_I2C_ADDR, REG_EN_RST, 0x18);  // Bits [4:3] = 11 → Always ON
}

// Set LED currents
void KTD2026_SetCurrent(uint8_t reg, uint8_t value) {
    I2C_Write(KTD2026_I2C_ADDR, reg, value);
}

// Enable LEDs via Reg4
void KTD2026_EnableLEDs(uint8_t enableMask) {
    I2C_Write(KTD2026_I2C_ADDR, REG_LED_EN, enableMask);
}

// Color Functions
void LED_Blue(void) {
    KTD2026_SetCurrent(REG_LED3_CUR, LED_CUR_10mA);
    KTD2026_EnableLEDs(0x01 << 2);  // LED3 = ON
}

void LED_Yellow(void) {
    KTD2026_SetCurrent(REG_LED1_CUR, LED_CUR_10mA);
    KTD2026_SetCurrent(REG_LED2_CUR, LED_CUR_10mA);
    KTD2026_EnableLEDs((0x01 << 0) | (0x01 << 1)); // LED1 + LED2 ON
}

void LED_Purple(void) {
    KTD2026_SetCurrent(REG_LED1_CUR, LED_CUR_10mA);
    KTD2026_SetCurrent(REG_LED3_CUR, LED_CUR_10mA);
    KTD2026_EnableLEDs((0x01 << 0) | (0x01 << 2)); // LED1 + LED3 ON
}
